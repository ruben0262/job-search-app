# The notify dispatcher, every 5 minutes. Install alongside notify-dispatch.service:
#
#   sudo cp deploy/notify-dispatch.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now notify-dispatch.timer
#   systemctl list-timers notify-dispatch.timer
#
# Five minutes, not fifteen: the per-user interval lives in `users.notify_interval_min` (60 by
# default) and this only decides how *late* a due feed can be. A 15-minute tick would make an
# hourly feed arrive up to 15 minutes after it was due for no benefit; a pass over a handful of
# users costs one query.
[Unit]
Description=job-search-app notify dispatcher

[Timer]
# Long enough after boot that Postgres is healthy and the worker has claimed its lane, so the first
# pass of the day does not enqueue into a stack that is still coming up.
OnBootSec=3min
OnUnitActiveSec=5min
# Offset from the harvester and the health check, both of which touch the same tables.
RandomizedDelaySec=30
# No catch-up. `next_run_at` already records who is due; firing four missed passes after downtime
# would enqueue the same users four times, and duplicate collapse would absorb it — but the
# behaviour to rely on is the state in the database, not the queue's forgiveness.
Persistent=false
Unit=notify-dispatch.service

[Install]
WantedBy=timers.target
