# Nightly backup, then exit. Invoked by backup.timer.
#
# **SECRETS_KEK is deliberately absent from the environment here.** The dump must not contain it and
# this script has no use for it — a backup beside its key is a credential breach in one file, and
# the surest way to keep them apart is for the process that writes one to be unable to read the
# other (OPERATIONS_PLAN.md §7).
[Unit]
Description=job-search-app nightly MongoDB backup (one-shot)
# The database is Atlas, off this box: the network, not Docker, is what this needs.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ruben
WorkingDirectory=/home/ruben/job-search-app
EnvironmentFile=/home/ruben/job-search-app/deploy/.env
ExecStart=/home/ruben/job-search-app/.venv/bin/python deploy/scripts/backup.py --out /home/ruben/backups --archive /home/ruben/job-search-app/archive
# A backup that cannot finish in fifteen minutes at this size is a symptom, not a slow link.
TimeoutStartSec=15min
