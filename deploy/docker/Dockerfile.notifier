# The notifier image. Per-service dependencies, per CODE_STRUCTURE.md §5.
#
# No numpy, no sklearn: this reads rows and posts to Telegram. Keeping it small is what
# makes it fast to restart, which matters because delivery is the user-visible half.
FROM python:3.12-slim

WORKDIR /app

COPY services/notifier/requirements.txt /app/services/notifier/requirements.txt
RUN pip install --no-cache-dir -r /app/services/notifier/requirements.txt

COPY libs /app/libs
COPY services/__init__.py /app/services/__init__.py
COPY services/notifier /app/services/notifier

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

ENTRYPOINT ["python", "-m", "services.notifier"]
