# The docgen image. **The only image with Chrome** (CODE_STRUCTURE.md §5).
#
# ~400MB of browser and a spiky memory profile on a box where a memory crunch has already caused
# one incident. Keeping it in one image is why the other seven stay small and quick to rebuild, and
# why a CV build cannot take the API down with it — compose bounds this one's memory on its own.
FROM node:22-slim AS node
FROM python:3.12-slim

WORKDIR /app

# Chromium rather than Google Chrome: it is in Debian's own archive, so there is no third-party apt
# key to trust and no repository that can disappear. `--print-to-pdf` is the only feature used here
# and the two browsers implement it identically.
#
# Every face a template asks for first is NOT optional (`libs/templates`): Lato (Meridian, Halcyon,
# Prism), Liberation Serif and Sans (Ledger, Foundry), Carlito (Kestrel, Tabula), Caladea (Quill).
# Chrome falls back to another face in silence when one is missing, which produces a CV that is correct
# in every respect except the one anybody would notice. The `fc-list` checks are what turn that silent
# fallback into a build failure here, where somebody is watching; `tests/test_templates.py` fails when
# a template names a face that is not checked here.
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium fontconfig fonts-lato fonts-liberation \
       fonts-crosextra-carlito fonts-crosextra-caladea \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f \
    && fc-list | grep -qi "lato" \
    && fc-list | grep -qi "liberation serif" \
    && fc-list | grep -qi "liberation sans" \
    && fc-list | grep -qi "carlito" \
    && fc-list | grep -qi "caladea"

ENV CHROME_BIN=/usr/bin/chromium

# Node and the three providers' own tools, which write a document with a signed-in AI account
# (`libs.llm.cli`): the same versions the sign-in broker installs, from the one list.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY deploy/docker/ai-tools.txt /tmp/ai-tools.txt
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install -g $(cat /tmp/ai-tools.txt) && claude --version && codex --version && gemini --version

# Dependencies first, so a code change does not re-resolve them.
COPY services/docgen/requirements.txt /app/services/docgen/requirements.txt
RUN pip install --no-cache-dir -r /app/services/docgen/requirements.txt

# libs/ AND services/docgen/, because the boundary rule is services -> libs. The CV template and the
# SACRED prompts arrive with libs/, which is what keeps one copy of them on the platform.
COPY libs /app/libs
COPY services/__init__.py /app/services/__init__.py
COPY services/docgen /app/services/docgen

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# A generated document never touches this container's disk (D9): Chrome is handed the HTML and hands
# back the PDF over its DevTools pipe, and the bytes wait in MongoDB for their download.
ENTRYPOINT ["python", "-m", "services.docgen"]
