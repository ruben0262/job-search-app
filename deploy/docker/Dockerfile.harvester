# The harvester image. Per-service dependencies, per CODE_STRUCTURE.md §5: this is the only image
# that will carry jobspy, just as docgen is the only one carrying Chrome. Keeping them separate is
# what lets api and notifier stay small and fast to rebuild, which matters because they are what
# gets restarted most.
#
# python:3.12-slim to match the embedder gateway. CI runs 3.12 for the same reason - the tree should
# not depend on a newer interpreter than the thing that ships.
FROM python:3.12-slim

WORKDIR /app

# Dependencies first, so a code change does not re-resolve them.
COPY services/harvester/requirements.txt /app/services/harvester/requirements.txt
RUN pip install --no-cache-dir -r /app/services/harvester/requirements.txt

# libs/ AND services/harvester/, because the boundary rule is services -> libs. Nothing else is
# copied: this image has no reason to contain another service's code, and not shipping it is the
# cheapest way to keep that true.
COPY libs /app/libs
COPY services/__init__.py /app/services/__init__.py
COPY services/harvester /app/services/harvester

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# One cycle, then exit. Scheduling is external - see deploy/harvester.timer and deploy/README.md.
ENTRYPOINT ["python", "-m", "services.harvester"]
