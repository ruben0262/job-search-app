# The harvester image. Per-service dependencies, per CODE_STRUCTURE.md §5: this is the only image
# that will carry jobspy, just as docgen is the only one carrying Chrome. Keeping them separate is
# what lets api and notifier stay small and fast to rebuild, which matters because they are what
# gets restarted most.
#
# python:3.12-slim to match the embedder gateway. CI runs 3.12 for the same reason - the tree should
# not depend on a newer interpreter than the thing that ships.
FROM python:3.12-slim

WORKDIR /app

# Dependencies first, so a code change does not re-resolve them.
COPY services/harvester/requirements.txt /app/services/harvester/requirements.txt
# At the versions the gates ran on (`scripts/pin_runtime.py`), not whatever is newest today.
COPY deploy/docker/constraints.txt /tmp/constraints.txt
RUN pip install --no-cache-dir -c /tmp/constraints.txt -r /app/services/harvester/requirements.txt

# libs/ AND services/harvester/, because the boundary rule is services -> libs. Nothing else is
# copied: this image has no reason to contain another service's code, and not shipping it is the
# cheapest way to keep that true.
COPY libs /app/libs
COPY services/__init__.py /app/services/__init__.py
COPY services/harvester /app/services/harvester

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# At most two of glibc's heaps ("arenas"), shared by every thread, not one a thread. Each thread reading a board
# kept the memory it freed in a heap of its own: a run reading every board of the dev copy at once peaked at 532 MB
# and still held 536 at its end, for 10 MB of jobs; with two, 225 MB and 170, and no slower (2026-11-24, CHANGELOG).
ENV MALLOC_ARENA_MAX=2

# Not as root: whatever goes wrong in here is the account that owns the checkout's logs, and no more. Its id
# is that account's (`deploy/compose.sh`), so what it writes to the folders the server lends it is the
# owner's to read. The code stays root's, which this account can read and not change.
ARG APP_UID=1001
RUN useradd --non-unique --create-home --uid ${APP_UID} app
USER app
ENV HOME=/home/app

# One cycle, then exit. Scheduling is external - see deploy/harvester.timer and deploy/README.md.
ENTRYPOINT ["python", "-m", "services.harvester"]
