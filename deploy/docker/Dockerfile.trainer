# The trainer image. Per-service dependencies, per CODE_STRUCTURE.md §5.
#
# Same numpy/sklearn world as the scorer and deliberately a separate image: a fit is CPU-
# fenced at concurrency 1 and should not share a restart cycle with the thing serving
# scores.
FROM python:3.12-slim

WORKDIR /app

COPY services/trainer/requirements.txt /app/services/trainer/requirements.txt
RUN pip install --no-cache-dir -r /app/services/trainer/requirements.txt

COPY libs /app/libs
COPY services/__init__.py /app/services/__init__.py
COPY services/trainer /app/services/trainer

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# Queue concurrency of 1 does not stop BLAS spawning a thread per core, and the caps only
# take effect before numpy is imported (SCHEDULER_PLAN.md §2). Set here as well as in the
# compose limits, because either alone has been enough to saturate the box.
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1

ENTRYPOINT ["python", "-m", "services.trainer"]
