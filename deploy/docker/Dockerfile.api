# The api image. Per-service dependencies, per CODE_STRUCTURE.md §5.
#
# No numpy, no sklearn, no scraping stack: this reads and writes rows, extracts document text, and
# sends email. Keeping it light is what makes it fast to rebuild and safe at the front of the
# request path.
FROM python:3.12-slim

WORKDIR /app

COPY services/api/requirements.txt /app/services/api/requirements.txt
RUN pip install --no-cache-dir -r /app/services/api/requirements.txt

COPY libs /app/libs
COPY services/__init__.py /app/services/__init__.py
COPY services/api /app/services/api

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# One worker. The box has eight cores but Postgres is the bottleneck long before uvicorn is, and a
# second worker would double the connection pool for an invited cohort that will not notice.
# Reached through the Cloudflare Tunnel (D7), so it binds inside the compose network only — there is
# no published port and the VPS needs no open inbound port at all.
EXPOSE 8000
ENTRYPOINT ["uvicorn", "services.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
