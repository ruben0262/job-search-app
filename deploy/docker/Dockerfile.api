# The api image: the JSON API **and** the site it serves.
#
# Two stages. The first builds the SPA with node and is thrown away; the second carries only Python
# and the compiled assets, so node never reaches the running image.
#
# Serving both from one process is a deliberate simplification of D7, which put the frontend on
# Cloudflare Pages. D7's requirement was no open inbound port and the tunnel already provides that;
# a second origin would add a CORS policy that stays untested until the day it is wrong. For a 69 kB
# bundle behind an invite-only beta, one origin and one deploy is the better trade.

FROM node:22-slim AS web
WORKDIR /web
# Dependencies first, so a change to a component does not re-resolve them.
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
# `npm run build` runs `tsc --noEmit` first, so a component reading a field the API does not return
# fails the image build rather than the page.
RUN npm run build

FROM python:3.12-slim

# The font an older upload's PDF is written in (`libs.documents.remake.FONT`): letters beyond Western
# Europe's, which the PDF's own fonts do not have.
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY services/api/requirements.txt /app/services/api/requirements.txt
RUN pip install --no-cache-dir -r /app/services/api/requirements.txt

COPY libs /app/libs
COPY services/__init__.py /app/services/__init__.py
COPY services/api /app/services/api
COPY --from=web /web/dist /app/web

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 WEB_DIR=/app/web

# Four workers. **It was one, and one of the reasons was a bug**: Claude sign-in sessions used to
# live in this process, so a second worker would have answered for sessions it had never heard of.
# Those moved to `oauthbroker`, which frees this to scale. The database (MongoDB Atlas, a network
# round trip away) is the bottleneck long before uvicorn is, so this is modest rather than one per
# core.
# No published port: reached through the Cloudflare Tunnel (D7), so the VPS needs none open.
EXPOSE 8000
ENTRYPOINT ["uvicorn", "services.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
