# The scorer image. Per-service dependencies, per CODE_STRUCTURE.md §5.
#
# Carries numpy and scikit-learn, which is why it is not folded in with api or notifier:
# those two are what get restarted most, and they should stay fast to rebuild.
FROM python:3.12-slim

WORKDIR /app

COPY services/scorer/requirements.txt /app/services/scorer/requirements.txt
RUN pip install --no-cache-dir -r /app/services/scorer/requirements.txt

COPY libs /app/libs
COPY services/__init__.py /app/services/__init__.py
COPY services/scorer /app/services/scorer

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

ENTRYPOINT ["python", "-m", "services.scorer"]
