# The Claude sign-in broker. See `services/oauthbroker/__main__.py` for why it is its own process.
#
# **The only image with node in the final layer.** `claude setup-token` is the Claude Code CLI, so
# this image needs it at runtime rather than at build time, which is the opposite of the API image
# (there node builds the SPA and is thrown away). Keeping that in one small service is most of the
# reason this is a service.
#
# **Python 3.12, as every other image; node copied in from the official image.** This was
# `node:22-slim` with Debian's own python3, which is 3.11, and the shared libs are written for 3.12
# (`def insert[D: Document]`): on the first deploy to the new server it crashed on import and
# restarted forever (2026-11-03). tests/test_deploy_config.py holds every image to the one Python.
FROM node:22-slim AS node

FROM python:3.12-slim

# node itself and npm, which is a script beside it: the CLI below is an npm package.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && node --version && npm --version

# The three providers' own tools, at the versions in `ai-tools.txt`, which the docgen image installs too:
# a login one version writes is what the other reads. **Pinned, and the pin is load-bearing.** This
# service reads two things out of each tool's output: the link it prints, and the prompt it waits on.
# Both are prose a release is free to reword, so `latest` means a routine rebuild can break sign-in for
# every new person with nothing in this repository having changed. Raise one deliberately, and re-run
# tests/test_signin.py against it.
COPY deploy/docker/ai-tools.txt /tmp/ai-tools.txt
RUN npm install -g $(cat /tmp/ai-tools.txt) && claude --version && codex --version && gemini --version

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PATH="/opt/venv/bin:$PATH"

RUN python3 -m venv /opt/venv
COPY services/oauthbroker/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY libs /app/libs
COPY services/oauthbroker /app/services/oauthbroker

# A non-root user, because this image runs a CLI that opens network connections on a user's behalf
# and writes to its own config directory.
#
# **The uid matches the host account that owns ../logs.** At 10001 the audit lines for every
# sign-in were dropped: `libs.obs` warns that the directory is unwritable and carries on to the
# console, so the service looked healthy while the one record of who connected what went nowhere.
#
# Set by `deploy/compose.sh` to the uid that owns the checkout. `--non-unique`, so it may share a uid
# with an account the base image already has.
ARG BROKER_UID=1001
RUN useradd --non-unique --create-home --uid ${BROKER_UID} broker && chown -R broker /app /home/broker
USER broker
ENV HOME=/home/broker

EXPOSE 8100
ENTRYPOINT ["python", "-m", "services.oauthbroker"]
