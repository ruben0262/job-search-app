# One health evaluation, then exit. Invoked by health.timer.
#
# **The exit code is the interface**: 0 nothing, 1 warnings, 2 something needs a person. The script
# also emails on a page, but the exit code is what survives a broken mail configuration — and a
# monitoring system whose own failure is silent is the thing OPERATIONS_PLAN.md §1 warns about.
[Unit]
Description=job-search-app platform health check (one-shot)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ruben
WorkingDirectory=/home/ruben/job-search-app
# Reads DATABASE_URL, SECRETS_KEK, the SMTP settings and ADMIN_EMAILS. Same file the stack uses, so
# there is one place to change a password rather than two that drift.
EnvironmentFile=/home/ruben/job-search-app/deploy/.env
Environment=DATABASE_URL=postgresql+psycopg://jobsearch:${POSTGRES_PASSWORD}@127.0.0.1:5432/jobsearch
ExecStart=/home/ruben/job-search-app/.venv/bin/python deploy/scripts/check_health.py --email-on page
# A check that cannot finish in a minute is itself a symptom.
TimeoutStartSec=60
# SuccessExitStatus so a warning (1) does not mark the unit failed and start a restart storm. A
# page (2) IS a unit failure on purpose — `systemctl --failed` then shows it even if mail is down.
SuccessExitStatus=0 1
