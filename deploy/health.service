# One health evaluation, then exit. Invoked by health.timer.
#
# **The exit code is the interface**: 0 nothing, 3 warnings, 2 something needs a person. The script
# also emails on a page, but the exit code is what survives a broken mail configuration — and a
# monitoring system whose own failure is silent is the thing OPERATIONS_PLAN.md §1 warns about.
#
# **Warnings are 3 and not 1 because 1 is what an uncaught exception returns.** They were the same
# number until 2026-08-11, and `SuccessExitStatus` tolerated it, so when this check started dying on
# a bad password on 2026-07-29 systemd read the crash as a clean run: 2,318 failures, zero successes,
# and `systemctl --failed` clean for thirteen days. The one thing that would have reported the
# backup dying the same day was the thing quietly not running.
[Unit]
Description=job-search-app platform health check (one-shot)
# The database is Atlas, off this box: the network, not Docker, is what this needs.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ruben
WorkingDirectory=/home/ruben/job-search-app
# Reads SECRETS_KEK, the SMTP settings, ADMIN_EMAILS and MONGODB_URI. Same file the stack uses, so
# there is one place to change a password rather than two that drift. MONGODB_URI is a whole value
# in that file, so nothing here has to assemble one — which is how this unit once spent a fortnight
# authenticating with the literal string `${POSTGRES_PASSWORD}`.
EnvironmentFile=/home/ruben/job-search-app/deploy/.env
ExecStart=/home/ruben/job-search-app/.venv/bin/python deploy/scripts/check_health.py --email-on page
# A check that cannot finish in a minute is itself a symptom.
TimeoutStartSec=60
# So a warning (3) does not mark the unit failed and start a restart storm. A page (2) IS a unit
# failure on purpose — `systemctl --failed` then shows it even if mail is down. **1 is deliberately
# absent**: that is the code a crash returns, and tolerating it is what hid this for thirteen days.
SuccessExitStatus=0 3
