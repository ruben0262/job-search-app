# Copy to .env alongside compose.yml, then fill in. Compose reads .env from its own directory
# automatically. .env is gitignored and must stay that way — it is a credential file.
#
#   cd deploy
#   cp .env.example .env
#   printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -base64 32)" > .env
#   chmod 600 .env

# No default on purpose: compose.yml uses `${POSTGRES_PASSWORD:?}`, so the stack refuses to start
# rather than coming up with a guessable password nobody remembers to change.
POSTGRES_PASSWORD=

# The key-encryption key for every user credential (TENANT_SAFETY.md §2). Generate with:
#
#   python -c "from libs.secrets import generate_key; print(generate_key())"
#
# Format is one or more comma-separated `<key_id>:<base64url>` entries, newest first. A bare key
# with no id is accepted and treated as `k0`, so the first deployment does not have to understand
# rotation — but naming it now is what makes the first rotation a config change:
#
#   SECRETS_KEK=k2:<new key>,k1:<retired key>
#
# New DEKs are wrapped with the FIRST entry; the rest exist only to unwrap rows written before the
# rotation. Once `SecretStore.users_needing_rewrap()` returns empty, the retired entry can be
# dropped. Removing it too early makes those users' credentials unreadable, so check first.
#
# There is deliberately no default. A service with no KEK refuses to start rather than falling back
# to something weaker, because a fallback would make every test of this design pass and the design
# itself worthless.
SECRETS_KEK=

# ⚠ Back this file up somewhere OTHER than wherever the database backups live.
# OPERATIONS_PLAN.md §7 names the two silent failure modes, and they apply to every secret the
# platform holds — but they are sharpest for SECRETS_KEK, which is the one key the whole envelope
# design assumes a database thief does not have:
#   secret stored WITH the backup  → one stolen file is a complete breach
#   secret stored NOWHERE          → the restore produces a database nobody can read
#
# Both halves belong in the restore drill: restore the database, restore the KEK from its separate
# location, and prove a credential decrypts. A drill that only restores the database proves nothing
# about whether the accounts still work.

# ── the API service ───────────────────────────────────────────────────────────────────────────

# Signs the 15-minute access token. Generate with:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# No default, deliberately: a signing key with a known value is not a signing key, and every test
# of the auth flow would still pass with one.
ACCESS_TOKEN_SECRET=

# Where verification links point. Must be the address a user's browser can actually reach — the
# Cloudflare Tunnel hostname (D7), not the VPS.
PUBLIC_URL=https://jobs.example.com

# ── transactional email (Zoho, no-reply@flow-solutions.xyz) ───────────────────────────────────
#
# The platform sends signup confirmations, health alerts and delivery-failure notices as
# **no-reply@flow-solutions.xyz**, through Zoho — the same mailbox the other FlowSolutions services
# already send through, so SPF and DKIM for the domain are correct and mail does not land in spam.
# Settings confirmed against `filip_project/flowsolutions-ai/docs/setup/smtpcheck.md`.
#
# **If the mailbox has 2FA this must be a Zoho app password, not the login password.** SMTP auth
# fails with a plain password on a 2FA account, and the error reads like a wrong password rather
# than a wrong *kind* of password — which is an hour lost to the wrong theory.
#
# To test the credential before wiring it here, that repo has a standalone checker:
#   SMTPCHECK_PASSWORD='...' go run ./cmd/smtpcheck -host smtp.zoho.com -port 587 #       -security starttls -username no-reply@flow-solutions.xyz
#
# **With these unset the API prints emails instead of sending them.** That is deliberate — a
# developer can run the whole signup flow and read the verification link from the log — but on the
# box it is a misconfiguration that looks like nothing is wrong: signup returns success and the
# confirmation never arrives.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=587
SMTP_USER=no-reply@flow-solutions.xyz
SMTP_PASSWORD=
MAIL_FROM=no-reply@flow-solutions.xyz

# The platform's own ceiling, counted over a rolling 24 hours — not a calendar day, because that is
# how a provider meters it, and a midnight reset would call 400 at 23:00 plus 400 at 01:00 two
# compliant days. Set below the provider's own limit so the headroom absorbs a burst: being refused
# by our cap is visible and recoverable, being silently throttled by Zoho is neither.
MAIL_DAILY_CAP=400
