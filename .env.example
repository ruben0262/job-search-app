# ── job-search-embedder configuration ───────────────────────────────────────
# Copy to .env and adjust. The gateway + TEI read these at start.

# Embedding model (MUST match what every caller's classifier was trained on).
# Default = bge-small (384-dim, CPU-fast, fits the <2GB budget). See docs/PLAN.md §10:
# standardise all tenants on ONE model; the off-model tenant retrains onto it.
EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
EMBEDDER_DIM=384
# L2-normalise output vectors. MUST match how the classifiers were trained (parity gate,
# PLAN §14.1). fastembed BGE returns normalised vectors, so keep this true.
EMBEDDER_NORMALIZE=true

# ── Gateway ↔ TEI wiring (container-network names; no host ports by default) ──
# The gateway always listens on 8080 inside the network (consumers use http://embedder-gateway:8080);
# publish a host port in docker-compose.yml only behind TLS + EMBEDDER_AUTH_TOKEN.
TEI_URL=http://tei:80

# ── Batching / lanes (PLAN §4b). Tune empirically on the box; these are safe starts. ──
# Max texts allowed in ONE call to TEI. Read by BOTH sides — it becomes TEI's
# --max-client-batch-size AND the gateway's chunk ceiling, so they cannot drift apart (TEI answers
# 413 to anything larger). The gateway additionally clamps to whatever TEI's /info reports.
TEI_MAX_CLIENT_BATCH=32
# Bulk-lane chunk size (clamped to TEI_MAX_CLIENT_BATCH). TEI's CPU backend caps its INTERNAL
# batch at 8, so anything above 8 buys no inference speed and only blocks a worker (and TEI's
# queue head) for longer — which starves the score lane. Also caps the onnxruntime working set.
EMBEDDER_BULK_CHUNK=8
# Separate worker pools per lane. Priority alone cannot protect the fast lane: a score request
# still waits for an in-flight bulk call to return, so the score lane gets workers of its own.
# Keep bulk workers LOW on a shared CPU box — more of them just fills TEI's internal queue and
# pushes score requests behind it (measured: 0.08s idle -> 8-15s with a shared pool).
EMBEDDER_SCORE_WORKERS=2
EMBEDDER_BULK_WORKERS=1
# Hard cap on texts accepted in a single request (reject oversized payloads).
EMBEDDER_MAX_TEXTS=4096
# Max chunks queued PER LANE before the gateway sheds load with 503 (PLAN §4c "bound the queue").
# An unbounded queue turns a throughput problem into an OOM; backpressure is the honest signal.
# Sizing: one bulk request of N texts enqueues N/EMBEDDER_BULK_CHUNK chunks at once — a 2000-text
# cold-start train is 250 chunks. With several tenants this must comfortably exceed the largest
# concurrent training burst or a legitimate retrain gets a 503. Queued items hold only text, so
# headroom here is cheap (~2k chunks ≈ tens of MB).
EMBEDDER_MAX_QUEUE=2048

# ── TEI engine flags (mirrored into the tei service command) ──
# Token budget per internal batch — THIS is the memory cap (PLAN §4b/§12). Raise for throughput,
# lower if peak RSS approaches 2GB. Measure, don't guess.
TEI_MAX_BATCH_TOKENS=16384
TEI_MAX_CONCURRENT_REQUESTS=512

# ── Auth (OFF by default = shared-Docker-network-only, PLAN network decision) ──
# Leave blank for container-to-container use. Set a long random token BEFORE exposing any
# public/host port — an un-authed embedding endpoint is a CPU-DoS magnet.
EMBEDDER_AUTH_TOKEN=
